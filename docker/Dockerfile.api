# Stage 1: Build
FROM node:20-bookworm-slim AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@12.21.0

# Copy root workspace configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

# Install dependencies and build shared + api
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @chhapai/shared build
RUN pnpm --filter @chhapai/api prisma:generate
RUN pnpm --filter @chhapai/api build

# Stage 2: Production Runner
FROM node:20-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000
ENV STORAGE_PATH=/data/files
ENV TZ=Asia/Karachi

# Install LibreOffice headless, fonts, and required packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    fonts-noto \
    fonts-noto-cjk \
    fonts-dejavu-core \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN npm install -g pnpm@12.21.0

# Create non-root user and directories
RUN groupadd -r chhapai && useradd -r -g chhapai -m -d /home/chhapai chhapai
RUN mkdir -p /data/files && chown -R chhapai:chhapai /data/files

# Copy files from builder
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/apps/api ./apps/api

# Install production dependencies only
RUN pnpm install --prod --frozen-lockfile
RUN pnpm --filter @chhapai/api prisma:generate

RUN chown -R chhapai:chhapai /app

USER chhapai

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:4000/api/v1/health || exit 1

CMD ["node", "apps/api/dist/main.js"]
