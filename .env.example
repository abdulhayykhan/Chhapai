# ==============================================================================
# Chhapai (چھپائی) - Environment Configuration Example
# ==============================================================================

# Domain Configuration
DOMAIN=yourshop.pk
API_DOMAIN=api.yourshop.pk
ACME_EMAIL=owner@yourshop.pk

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://chhapai:chhapai_secret_pw@localhost:5432/chhapai_db?schema=public
POSTGRES_USER=chhapai
POSTGRES_PASSWORD=chhapai_secret_pw
POSTGRES_DB=chhapai_db

# Security & JWT Secrets (Minimum 32 random characters in production)
JWT_ACCESS_SECRET=access_secret_production_random_key_32c
JWT_REFRESH_SECRET=refresh_secret_production_random_key_32c

# Application URLs
PUBLIC_WEB_URL=https://yourshop.pk
NEXT_PUBLIC_API_URL=https://api.yourshop.pk/api/v1
CORS_ORIGINS=https://yourshop.pk,https://www.yourshop.pk

# Storage & Timezone
STORAGE_PATH=/data/files
TZ=Asia/Karachi

# Initial Shop & Owner Seed Configuration
SEED_SHOP_SLUG=default
SEED_SHOP_NAME=Chhapai Print Shop
SEED_ADMIN_EMAIL=admin@chhapai.pk
SEED_ADMIN_PASSWORD=AdminPassword123!
