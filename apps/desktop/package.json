{
  "name": "@chhapai/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Walk-in self-service printing counter app for Chhapai",
  "author": "Abdul Hayy Khan (https://abdulhayykhan.dev)",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdulhayykhan/Chhapai.git"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --external:electron --external:pdf-to-printer --outfile=dist/main/index.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/preload/index.js",
    "build:renderer": "vite build",
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
    "dev:renderer": "vite",
    "dev:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --external:electron --external:pdf-to-printer --outfile=dist/main/index.js && esbuild src/preload/index.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/preload/index.js",
    "start": "electron .",
    "package": "pnpm run build && electron-builder --win --publish never",
    "test": "vitest run"
  },
  "build": {
    "appId": "pk.chhapai.counter",
    "productName": "Chhapai",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/pdf-to-printer/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chhapai"
    }
  },
  "dependencies": {
    "@chhapai/shared": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "pdf-to-printer": "^5.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^31.7.7",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
