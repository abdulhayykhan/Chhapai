datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  PENDING_APPROVAL
  APPROVED
  PRINTING
  COMPLETED
  REJECTED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum ColorMode {
  BW
  COLOR
}

enum Sides {
  SINGLE
  DOUBLE
}

enum PaperSize {
  A4
  A3
  LEGAL
}

enum UserRole {
  OWNER
  STAFF
}

model Shop {
  id                 String      @id @default(uuid())
  slug               String      @unique
  name               String
  nameUrdu           String?
  phone              String?
  address            String?
  isOpen             Boolean     @default(true)
  autoPrint          Boolean     @default(true)
  bwPrinter          String?
  colorPrinter       String?
  rateBwSingle       Decimal     @default(5) @db.Decimal(8, 2)
  rateBwDouble       Decimal     @default(4) @db.Decimal(8, 2)
  rateColorSingle    Decimal     @default(30) @db.Decimal(8, 2)
  rateColorDouble    Decimal     @default(25) @db.Decimal(8, 2)
  maxFileMb          Int         @default(25)
  maxPages           Int         @default(200)
  retentionMinutes   Int         @default(60)
  pendingExpiryHours Int         @default(24)
  createdAt          DateTime    @default(now())
  users              AdminUser[]
  jobs               PrintJob[]
}

model AdminUser {
  id            String         @id @default(uuid())
  shopId        String
  shop          Shop           @relation(fields: [shopId], references: [id])
  email         String         @unique
  name          String
  passwordHash  String
  role          UserRole       @default(OWNER)
  isActive      Boolean        @default(true)
  failedLogins  Int            @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model Upload {
  id           String    @id @default(uuid())
  shopId       String
  fileKey      String
  originalName String
  originalMime String
  sizeBytes    Int
  pageCount    Int
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  job          PrintJob?
}

model PrintJob {
  id               String        @id @default(uuid())
  shopId           String
  shop             Shop          @relation(fields: [shopId], references: [id])
  tokenDate        DateTime      @db.Date
  tokenSeq         Int
  tokenLabel       String
  publicToken      String        @unique
  status           JobStatus     @default(PENDING_APPROVAL)
  customerName     String
  customerPhone    String?
  uploadId         String        @unique
  upload           Upload        @relation(fields: [uploadId], references: [id])
  copies           Int
  colorMode        ColorMode
  sides            Sides
  paperSize        PaperSize     @default(A4)
  pageRange        String?
  pagesPerCopy     Int
  printedPages     Int
  unitRate         Decimal       @db.Decimal(8, 2)
  calculatedAmount Int
  finalAmount      Int
  paymentStatus    PaymentStatus @default(UNPAID)
  paidAt           DateTime?
  rejectReason     String?
  failReason       String?
  approvedAt       DateTime?
  printStartedAt   DateTime?
  completedAt      DateTime?
  fileDeletedAt    DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  events           JobEvent[]

  @@unique([shopId, tokenDate, tokenSeq])
  @@index([shopId, status, createdAt])
}

model JobEvent {
  id          String     @id @default(uuid())
  jobId       String
  job         PrintJob   @relation(fields: [jobId], references: [id])
  type        String
  fromStatus  JobStatus?
  toStatus    JobStatus?
  actorUserId String?
  message     String?
  createdAt   DateTime   @default(now())
}
